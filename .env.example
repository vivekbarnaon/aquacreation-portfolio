# ========================================================
# AquaCreation Portfolio — Environment Variables Configuration
# ========================================================

# 1. Resend API Key for Transactional Emails
# Generate an API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. Receiving Email Address
# Destination inbox where prospective client briefs will be forwarded
CONTACT_TO_EMAIL=vivekbarnaon@gmail.com

# 3. Verified Sender Email
# Use your verified domain on Resend (e.g., hello@aquacreation.com)
# For initial testing before domain verification, you can use: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# 4. Optional Base URL for Canonical SEO links
NEXT_PUBLIC_SITE_URL=https://aquacreation.vercel.app
